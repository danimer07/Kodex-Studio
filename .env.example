# Copia este archivo a ".env" (local) y ponlo también en Vercel > Settings > Environment Variables.
# NUNCA subas el archivo .env a GitHub.

# Neon > Dashboard > Connect > copia la "connection string" (la de pooler está bien)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Contraseña con la que entras a /admin (elige una larga)
ADMIN_PASSWORD=cambia-esta-clave

# Cadena aleatoria para firmar la sesión del admin. Genera una con:  openssl rand -hex 32
SESSION_SECRET=
